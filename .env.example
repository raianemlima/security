# Opcional. Nunca faça commit da chave real.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6
# Timeout das chamadas à API de IA (segundos)
OPENAI_TIMEOUT=60
# Timeout máximo de requisições HTTP (segundos, entre 1 e 60)
HTTP_TIMEOUT=8
# Configuração do Semgrep: pack do registry (padrão p/default) ou arquivo de regras local para uso offline
VULNAGENT_SEMGREP_CONFIG=p/default
# Ao expor o painel em rede: restrinja "Pasta local" a estas raízes (separadas por ';' no Windows e ':' no Linux/macOS)
VULNAGENT_ALLOWED_ROOTS=
# Ou desative "Pasta local" por completo (1 = desativado), deixando apenas Upload ZIP
VULNAGENT_DISABLE_LOCAL_PATH=
